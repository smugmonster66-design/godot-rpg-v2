[sub_resource type="Resource" id="obj_interact"]
script = ExtResource("2_obj")
objective_id = &"open_stash"
description = "Open the secret stash"
objective_type = 5
target_id = &"secret_stash"

[sub_resource type="Resource" id="sc_flag"]
script = ExtResource("5_sc")
check_type = 0
key = &"explorer_instinct_complete"
bool_value = true

[sub_resource type="Resource" id="prereq"]
script = ExtResource("4_cond")
