single_check = SubResource("sc_flag")

[sub_resource type="Resource" id="rewards"]
script = ExtResource("3_rew")
experience = 60
gold = 200

[resource]
script = ExtResource("1_def")
quest_id = &"secret_stash"
display_name = "The Secret Stash"
quest_type = 6
summary = "A hidden stash awaits the truly observant."
description = "You've heard whispers of a secret stash hidden somewhere only an experienced explorer would find. Perhaps the hidden cove holds the answer."
objectives = Array[ExtResource("2_obj")]([SubResource("obj_interact")])
rewards = SubResource("rewards")
prerequisites = SubResource("prereq")
hidden_until_accepted = true
auto_complete = true
