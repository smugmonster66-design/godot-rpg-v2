[resource]
script = ExtResource("1_def")
quest_id = &"smugglers_cache"
display_name = "The Smuggler's Cache"
summary = "A rumored cache of contraband lies hidden along the coast."
description = "Sailors at the docks whisper about a smuggler who hid a cache of valuable goods in a hidden cove. Finding it could yield useful equipment."
quest_giver_id = &"harbor_master"
quest_giver_location = &"docks"
objectives = Array[ExtResource("2_obj")]([SubResource("obj_visit"), SubResource("obj_interact")])
rewards = SubResource("rewards")
prerequisites = SubResource("Resource_6insd")
