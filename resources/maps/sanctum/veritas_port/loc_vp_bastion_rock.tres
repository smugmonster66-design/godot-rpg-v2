[gd_resource type="Resource" script_class="LocationNode" load_steps=9 format=3]

[ext_resource type="Script" path="res://resources/data/location_node.gd" id="1_x"]
[ext_resource type="Script" path="res://resources/data/map_node_button_def.gd" id="2_x"]
[ext_resource type="Resource" path="res://resources/maps/common/btn_npcs.tres" id="3_x"]
[ext_resource type="Resource" path="res://resources/maps/common/btn_rest_free.tres" id="4_x"]
[ext_resource type="Script" path="res://resources/data/single_check.gd" id="5_x"]
[ext_resource type="Script" path="res://resources/data/game_condition.gd" id="6_x"]

[sub_resource type="Resource" id="check_unlock"]
script = ExtResource("5_x")
key = &"off_the_boat_done"

[sub_resource type="Resource" id="cond_unlock"]
script = ExtResource("6_x")
condition_type = 2
single_check = SubResource("check_unlock")

[resource]
script = ExtResource("1_x")
location_id = &"loc_vp_bastion_rock"
display_name = "Bastion Rock"
node_type = 0
map_node_category = 0
radial_buttons = Array[ExtResource("2_x")]([ExtResource("3_x"), ExtResource("4_x")])
region_id = &"sanctum"
