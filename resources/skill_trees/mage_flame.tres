[resource]
script = ExtResource("1_ftk5x")
tree_id = "mage_flame"
tree_name = "Flame"
description = "Master fire magic. Three paths: Applier (lifesteal, chain, mana economy), Manipulator (dice positioning, value, defense), Exploiter (burn-to-barrier, self-burn, Detonate payoffs). Weave them at Forge Bond. The deeper you go, the more you become the fire."
tier_1_skills = Array[ExtResource("2_be7fa")]([ExtResource("sk_flame_ignite")])
