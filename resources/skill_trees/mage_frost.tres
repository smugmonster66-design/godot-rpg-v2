[resource]
script = ExtResource("1_7jxn5")
tree_id = "mage_frost"
tree_name = "Frost"
description = "Master ice magic. Three paths: Chill Applier (creative frost application), Freeze Exploiter (shatter and execute), Weave (feedback loops bridging both). Control through attrition — degrade enemy dice, freeze their turns."
